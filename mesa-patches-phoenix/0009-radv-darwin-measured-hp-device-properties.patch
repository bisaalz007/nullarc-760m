From 4b0795b50436909fdeb437c35666b36dcd1f3fa7 Mon Sep 17 00:00:00 2001
From: imnotsayingthatlol <norrisethan65@icloud.com>
Date: Sun, 8 Nov 2026 12:04:34 -0500
Subject: [PATCH] Use measured HP 760M device properties for its exact topology
 profile

---
 src/amd/common/darwin/ac_darwin_drm.c      |  4 +++
 src/amd/common/darwin/phx_hp_760m_device.h | 36 ++++++++++++++++++++++
 2 files changed, 40 insertions(+)
 create mode 100644 src/amd/common/darwin/phx_hp_760m_device.h

diff --git a/src/amd/common/darwin/ac_darwin_drm.c b/src/amd/common/darwin/ac_darwin_drm.c
index 5e5fee3..6ce388d 100644
--- a/src/amd/common/darwin/ac_darwin_drm.c
+++ b/src/amd/common/darwin/ac_darwin_drm.c
@@ -7,6 +7,7 @@
 #include "ac_darwin_drm.h"
 #include "ac_darwin_kext.h"
 #include "phx_hp_760m.h"
+#include "phx_hp_760m_device.h"
 #include "ac_darwin_budget.h"
 
 #include <errno.h>
@@ -545,6 +546,9 @@ acd_info(struct acd_device *dev, const struct drm_amdgpu_info *info)
          di->enabled_rb_pipes_mask = p->enabled_rb_pipes_mask;
          di->cu_active_number = p->cu_active_number;
          memcpy(di->cu_bitmap, p->cu_bitmap, sizeof(di->cu_bitmap));
+         if (phx_topology_matches(p, phx_hp_760m.vendor, phx_hp_760m.device, phx_hp_760m.revision,
+                                  phx_hp_760m.subvendor, phx_hp_760m.subdevice))
+            phx_hp_760m_apply_device_info(di);
       }
       return 0;
    }
diff --git a/src/amd/common/darwin/phx_hp_760m_device.h b/src/amd/common/darwin/phx_hp_760m_device.h
new file mode 100644
index 0000000..aba83b7
--- /dev/null
+++ b/src/amd/common/darwin/phx_hp_760m_device.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: MIT
+ * Generated by tools/phx_device_profile.py from live Linux capture 2026-11-08.
+ * Exact HP profile only. Clock limits are captured caps, not current clock state.
+ * No VA ranges, memory budgets, Linux flags, firmware state or readiness imported.
+ * Include after the DRM device-info structure definition.
+ */
+#ifndef PHX_HP_760M_DEVICE_H
+#define PHX_HP_760M_DEVICE_H
+static inline void phx_hp_760m_apply_device_info(struct drm_amdgpu_info_device *di) {
+    di->chip_rev = 12ull;
+    di->external_rev = 13ull;
+    di->family = 148ull;
+    di->gpu_counter_freq = 100000ull;
+    di->max_engine_clock = 2600000ull;
+    di->max_memory_clock = 800000ull;
+    di->vram_type = 12ull;
+    di->vram_bit_width = 128ull;
+    di->num_hw_gfx_contexts = 8ull;
+    di->wave_front_size = 32ull;
+    di->num_shader_visible_vgprs = 1024ull;
+    di->num_tcc_blocks = 4ull;
+    di->gs_vgt_table_depth = 32ull;
+    di->gs_prim_buffer_depth = 1792ull;
+    di->max_gs_waves_per_vgt = 32ull;
+    di->gc_double_offchip_lds_buf = 0ull;
+    di->pa_sc_tile_steering_override = 0ull;
+    di->tcc_disabled_mask = 0ull;
+    di->tcp_cache_size = 32ull;
+    di->num_sqc_per_wgp = 1ull;
+    di->sqc_data_cache_size = 16ull;
+    di->sqc_inst_cache_size = 32ull;
+    di->gl1c_cache_size = 256ull;
+    di->gl2c_cache_size = 2048ull;
+    di->mall_size = 0ull;
+}
+#endif
-- 
