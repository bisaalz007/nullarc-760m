From 8ae0bb59de2c50a338fe65dc077b50c566748457 Mon Sep 17 00:00:00 2001
From: imnotsayingthatlol <norrisethan65@icloud.com>
Date: Tue, 10 Nov 2026 21:36:28 -0500
Subject: [PATCH] Initialize command-buffer cleanup state before allocation can
 fail

---
 src/amd/vulkan/radv_cmd_buffer.c | 18 ++++++++++++------
 1 file changed, 12 insertions(+), 6 deletions(-)

diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index 1ae3241..5a7c3de 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -1323,7 +1323,8 @@ radv_destroy_cmd_buffer(struct vk_command_buffer *vk_cmd_buffer)

       radv_destroy_msrtss_transients(cmd_buffer);

-      radv_rra_accel_struct_buffers_unref(device, cmd_buffer->accel_struct_buffers);
+      if (cmd_buffer->accel_struct_buffers)
+         radv_rra_accel_struct_buffers_unref(device, cmd_buffer->accel_struct_buffers);
       _mesa_set_destroy(cmd_buffer->accel_struct_buffers, NULL);

       list_for_each_entry_safe (struct radv_cmd_buffer_upload, up, &cmd_buffer->upload.list, list) {
@@ -1401,6 +1402,12 @@ radv_create_cmd_buffer(struct vk_command_pool *pool, VkCommandBufferLevel level,
       list_inithead(&cmd_buffer->upload.list);

       radv_cmd_buffer_init_shader_part_cache(device, cmd_buffer);
+      /* Command-stream allocation can fail. Initialize every member visited
+       * by radv_destroy_cmd_buffer before entering that fallible path. */
+      for (unsigned i = 0; i < MAX_BIND_POINTS; i++)
+         vk_object_base_init(&device->vk, &cmd_buffer->descriptors[i].push_set.set.base, VK_OBJECT_TYPE_DESCRIPTOR_SET);
+      cmd_buffer->ray_history = UTIL_DYNARRAY_INIT;
+      list_inithead(&cmd_buffer->msrtss_transients);
       result =
          radv_create_cmd_stream(device, ip, cmd_buffer->vk.level == VK_COMMAND_BUFFER_LEVEL_SECONDARY, &cmd_buffer->cs);
       if (result != VK_SUCCESS) {
@@ -1408,12 +1415,11 @@ radv_create_cmd_buffer(struct vk_command_pool *pool, VkCommandBufferLevel level,
          return vk_error(device, VK_ERROR_OUT_OF_DEVICE_MEMORY);
       }

-      for (unsigned i = 0; i < MAX_BIND_POINTS; i++)
-         vk_object_base_init(&device->vk, &cmd_buffer->descriptors[i].push_set.set.base, VK_OBJECT_TYPE_DESCRIPTOR_SET);
-
       cmd_buffer->accel_struct_buffers = _mesa_pointer_set_create(NULL);
-      cmd_buffer->ray_history = UTIL_DYNARRAY_INIT;
-      list_inithead(&cmd_buffer->msrtss_transients);
+      if (!cmd_buffer->accel_struct_buffers) {
+         radv_destroy_cmd_buffer(&cmd_buffer->vk);
+         return vk_error(device, VK_ERROR_OUT_OF_HOST_MEMORY);
+      }
    }

    if (device->utrace.context) {
